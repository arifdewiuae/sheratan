{
  "name": "sheratan-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --type-aware --deny-warnings",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "coverage": "pnpm -r --if-present coverage",
    "verify": "pnpm -r --if-present verify",
    "security": "pnpm audit --audit-level low",
    "check": "pnpm format:check && pnpm build && pnpm lint && pnpm typecheck && pnpm test && pnpm coverage && pnpm verify && pnpm security",
    "security:signatures": "pnpm audit signatures"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "eslint-plugin-jsdoc": "64.3.10",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  }
}
